{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".cache/next/types/**/*.ts",
    ".cache/next/dev/types/**/*.ts",
    ".cache/production/types/**/*.ts",
    ".cache/production/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".cache/portals-test",
    ".cache/portals-preview",
    ".local"
  ]
}
