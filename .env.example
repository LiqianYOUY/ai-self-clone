# Local portal setup and synthetic experiment development. npm run dev generates
# a private local DB password if DATABASE_URL is omitted.
STUDY_MODE=synthetic
APP_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000

# Five-round friend game (/play), local Ollama by default. No API key needed.
# First run: npm run model:setup. Thereafter npm run dev starts the local runtime.
PLAY_MODEL_PROVIDER=ollama
PLAY_MODEL_BASE_URL=http://127.0.0.1:11434
PLAY_MODEL_NAME=qwen3.5:4b
PLAY_MODEL_API_KEY=
# Optional dedicated local server: preload before app startup and keep the model in memory.
PLAY_MODEL_RESIDENT=0
# Optional cloud/other compatible endpoint: set PLAY_MODEL_PROVIDER=compatible,
# an HTTPS API root (including /v1 if required), API key and exact model name.
# In that mode the program appends /chat/completions to PLAY_MODEL_BASE_URL.

# Project-owned Mac inference over an authenticated SSH reverse tunnel:
# PLAY_MODEL_PROVIDER=private-ollama
# PLAY_MODEL_BASE_URL=http://127.0.0.1:11441
# PLAY_MODEL_NAME=qwen3.5:9b
# PLAY_MODEL_API_KEY=GENERATE_A_PRIVATE_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# PLAY_MODEL_RESIDENT=1
# This mode never starts Ollama on the web/database host. See deploy/macos.

# npm run dev enables first-researcher setup on loopback only when omitted.
# For independently starting dev:app, explicitly enable once on a local machine.
# Set false to disable initial setup. Existing accounts are unaffected.
# PORTAL_BOOTSTRAP_ENABLED=false

# Optional external PostgreSQL (otherwise use persistent embedded PostgreSQL).
# DATABASE_URL=postgresql://study_app:REPLACE_ME@127.0.0.1:5432/clone_study?schema=public

# Required for non-loopback process binding and Docker. Send only in the
# x-demo-access-token login header. Generate with: openssl rand -hex 32
# DEMO_ACCESS_TOKEN=
# RESEARCH_DB_PASSWORD=
# IDENTITY_DB_PASSWORD=

# Live mode remains blocked. Approved protocol/config/identity/provider,
# safety duty, retention, backup, consent and independent validation evidence
# must be implemented and reviewed before any real participant deployment.
